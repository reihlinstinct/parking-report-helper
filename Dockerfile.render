# Render uses the HTTP target; all source is public and credential-free.
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
# Hash-locked installs only (#177): build prerequisites and the api extra from
# the locks, then the project itself with --no-deps --no-build-isolation.
COPY requirements/build.txt requirements/api.txt ./requirements/
RUN pip install --no-cache-dir --require-hashes \
    -r requirements/build.txt -r requirements/api.txt
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps --no-build-isolation . \
    && useradd --create-home --uid 10001 app
USER app
EXPOSE 10000
ENTRYPOINT ["parking-report-http"]
